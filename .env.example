# Required target. This server never switches targets through a tool argument.
ERPNEXT_URL=http://127.0.0.1:8080
# Optional pinned site header for multi-site deployments:
# ERPNEXT_SITE=erp.example.com
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me
# Alternative authentication (takes precedence over API key/secret):
# ERPNEXT_ACCESS_TOKEN=replace-me

# Safe Mode is this MCP's default execution contract. Accepted values: 1 or 0.
# 1: preflight writes, freeze requests, ask once per sensitive plan/batch.
# 0: explicit direct execution; input integrity and complete result storage remain enabled.
safe_mode=1

# Local durable state contains business payloads, responses and approval attestations.
# Relative to the selected env file. Keep private and outside version control.
ERPNEXT_STATE_DIR=.mcp-state
ERPNEXT_PLAN_TTL=3600
ERPNEXT_INLINE_RESULT_BYTES=12000
ERPNEXT_MAX_ARTIFACT_BYTES=67108864
ERPNEXT_MAX_STATE_BYTES=536870912

ERPNEXT_TIMEOUT=30
ERPNEXT_MAX_CONNECTIONS=8
ERPNEXT_MAX_KEEPALIVE_CONNECTIONS=4
ERPNEXT_KEEPALIVE_EXPIRY=30
ERPNEXT_METADATA_CACHE_TTL=60
ERPNEXT_METADATA_CACHE_MAX_ENTRIES=256
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8089
